---
import { categoryStyle, getCategory } from '../lib/categories';

interface Props {
  slug: string;
  link?: boolean;
  class?: string;
}

const { slug, link = true, class: className = '' } = Astro.props;
const category = getCategory(slug);
const Tag = link ? 'a' : 'span';
---

<Tag
  href={link ? `/category/${category.slug}/` : undefined}
  style={categoryStyle(category)}
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full border-2 border-ink bg-cat/25 px-2.5 py-0.5 text-sm font-display font-semibold no-underline whitespace-nowrap',
    link && 'hover:bg-cat/50',
    className,
  ]}
>
  <span aria-hidden="true">{category.emoji}</span>{category.name}
</Tag>
