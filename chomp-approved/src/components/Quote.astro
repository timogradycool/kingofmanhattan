---
interface Props {
  quote: string;
  size?: 'sm' | 'lg';
}
const { quote, size = 'sm' } = Astro.props;
---

<figure class:list={['bubble', size === 'lg' ? 'px-5 py-4 mb-8' : 'px-3.5 py-2.5 mb-5']}>
  <blockquote class:list={['font-display font-medium leading-snug', size === 'lg' ? 'text-xl sm:text-2xl' : 'text-base']}>
    “{quote}”
  </blockquote>
  {
    size === 'lg' && (
      <figcaption class="mt-2 text-sm font-semibold text-ink/70">— Remy, official approver</figcaption>
    )
  }
</figure>
