---
// The small CHOMP APPROVED! badge that sits next to every approved entry.
import { Image } from 'astro:assets';
import logo from '../assets/chomp-approved.png';

interface Props {
  /** Rendered size in pixels. */
  size?: number;
  class?: string;
}

const { size = 40, class: className = '' } = Astro.props;
---

<Image
  src={logo}
  alt="Chomp Approved!"
  title="Chomp Approved!"
  width={size}
  densities={[1, 2]}
  class:list={['inline-block shrink-0 drop-shadow-[1px_2px_0_rgb(20_20_20/0.25)]', className]}
  style={`width:${size}px;height:${size}px`}
/>
