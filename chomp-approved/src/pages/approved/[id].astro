---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/Badge.astro';
import CategoryChip from '../../components/CategoryChip.astro';
import Quote from '../../components/Quote.astro';
import EntryGrid from '../../components/EntryGrid.astro';
import { getApprovals, formatDate, isoDate, prettyLink, type Approval } from '../../lib/approvals';
import { categoryStyle, getCategory } from '../../lib/categories';

export async function getStaticPaths() {
  const approvals = await getApprovals();
  return approvals.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: Approval;
}

const { entry } = Astro.props;
const { name, remyQuote, dateApproved, photo, photoAlt, location, link, stickerAwarded, placeholder } = entry.data;
const category = getCategory(entry.data.category);
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
const more = (await getApprovals((e) => e.data.category === category.slug && e.id !== entry.id)).slice(0, 3);
---

<Layout
  title={name}
  description={remyQuote ? `“${remyQuote}” — Remy. ${name} is Chomp Approved!` : `${name} is Chomp Approved!`}
>
  <div style={categoryStyle(category)}>
    <div class="bg-cat border-b-4 border-ink">
      <nav aria-label="Breadcrumb" class="mx-auto max-w-4xl px-4 py-3 text-sm font-display font-semibold">
        <a href="/" class="hover:underline">Home</a>
        <span aria-hidden="true"> › </span>
        <a href={`/category/${category.slug}/`} class="hover:underline">{category.name}</a>
      </nav>
    </div>

    <article class="mx-auto max-w-4xl px-4 pt-8">
      {
        placeholder && (
          <p class="mb-5 rounded-2xl border-[3px] border-dashed border-ink bg-chomp-yellow/40 px-4 py-3 font-medium">
            <span class="placeholder-tag mr-2">Placeholder</span>
            This is a sample entry so you can see the layout. Delete it once real approvals are added.
          </p>
        )
      }

      <div class="sticker overflow-hidden">
        <div class="-m-[6px] mb-0 border-b-[3px] border-ink bg-cat rounded-t-[1.25rem] overflow-hidden">
          {
            photo ? (
              <Image
                src={photo}
                alt={photoAlt ?? name}
                widths={[480, 800, 1200]}
                sizes="(min-width: 896px) 860px, 94vw"
                class="w-full max-h-[70vh] object-cover"
                loading="eager"
              />
            ) : (
              <div class="aspect-[2/1] sm:aspect-[3/1] grid place-items-center" aria-hidden="true">
                <span class="text-8xl sm:text-9xl drop-shadow-[4px_6px_0_rgb(20_20_20/0.25)]">{category.emoji}</span>
              </div>
            )
          }
        </div>

        <div class="p-5 sm:p-8">
          <div class="flex flex-col-reverse gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <CategoryChip slug={category.slug} />
              <h1 class="mt-3 text-4xl sm:text-5xl">{name}</h1>
            </div>
            <div class="flex items-center gap-3 sm:flex-col sm:gap-1 sm:-mt-16 sm:-mr-2">
              <Badge size={112} class="-rotate-6" />
              <p class="font-display font-bold text-lg leading-tight sm:text-center">
                Chomp<br class="hidden sm:inline" /> Approved!
              </p>
            </div>
          </div>

          {remyQuote && (
            <div class="mt-6">
              <p class="mb-2 font-display font-bold text-ink/70 uppercase tracking-wide text-sm">Why Remy approves</p>
              <Quote quote={remyQuote} size="lg" />
            </div>
          )}

          <dl class="mt-6 grid gap-3 sm:grid-cols-2">
            <div class="rounded-2xl border-[3px] border-ink bg-cream px-4 py-3">
              <dt class="text-sm font-bold uppercase tracking-wide text-ink/60">📅 Approved on</dt>
              <dd class="font-display text-lg font-semibold">
                <time datetime={isoDate(dateApproved)}>{formatDate(dateApproved)}</time>
              </dd>
            </div>
            {
              location && (
                <div class="rounded-2xl border-[3px] border-ink bg-cream px-4 py-3">
                  <dt class="text-sm font-bold uppercase tracking-wide text-ink/60">📍 Location</dt>
                  <dd class="font-display text-lg font-semibold">{location}</dd>
                </div>
              )
            }
            {
              link && (
                <div class="rounded-2xl border-[3px] border-ink bg-cream px-4 py-3">
                  <dt class="text-sm font-bold uppercase tracking-wide text-ink/60">🔗 Check it out</dt>
                  <dd class="font-display text-lg font-semibold break-all">
                    <a href={link} target="_blank" rel="noopener noreferrer" class="underline hover:text-chomp-red">
                      {prettyLink(link)}
                    </a>
                  </dd>
                </div>
              )
            }
            {
              stickerAwarded && (
                <div class="rounded-2xl border-[3px] border-ink bg-chomp-yellow/50 px-4 py-3">
                  <dt class="text-sm font-bold uppercase tracking-wide text-ink/60">🏅 Sticker</dt>
                  <dd class="font-display text-lg font-semibold">Official sticker awarded!</dd>
                </div>
              )
            }
          </dl>

          {
            hasBody && (
              <div class="mt-6 max-w-none text-lg leading-relaxed [&_a]:underline [&_p]:mb-3">
                <Content />
              </div>
            )
          }
        </div>
      </div>
    </article>

    {
      more.length > 0 && (
        <section class="mx-auto max-w-6xl px-4 pt-14">
          <h2 class="mb-6 text-2xl sm:text-3xl">
            More Chomp Approved {category.name} <span aria-hidden="true">{category.emoji}</span>
          </h2>
          <EntryGrid entries={more} showCategory={false} />
        </section>
      )
    }
  </div>
</Layout>
