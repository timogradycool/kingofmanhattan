---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SearchableList from '../components/SearchableList.astro';
import { getApprovals } from '../lib/approvals';

const approvals = await getApprovals();
---

<Layout title="All Approvals" description="Every single thing Remy has approved, all in one place.">
  <PageHeader title="All Approvals" emoji="✅" color="var(--color-chomp-blue)">
    <p>Every single thing Remy has ever approved, newest first. Search by name or town, or tap a category.</p>
  </PageHeader>
  <div class="mx-auto max-w-6xl px-4 pt-8">
    <SearchableList entries={approvals} placeholder="Search by name, town, or anything…" />
  </div>
</Layout>
