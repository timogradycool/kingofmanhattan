---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <div class="mx-auto max-w-md px-4 pt-16 text-center">
    <p class="text-7xl" aria-hidden="true">🙈</p>
    <h1 class="mt-4 text-4xl">Oops! Not approved.</h1>
    <p class="mt-3 text-lg">We couldn’t find that page. Maybe it got eaten?</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn bg-chomp-yellow">Go home</a>
      <a href="/all/" class="btn bg-white">Search approvals</a>
    </div>
  </div>
</Layout>
