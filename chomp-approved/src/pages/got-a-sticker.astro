---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SearchableList from '../components/SearchableList.astro';
import logo from '../assets/chomp-approved.png';
import { getApprovals } from '../lib/approvals';

const stickered = await getApprovals((e) => e.data.stickerAwarded);

const points = [
  {
    emoji: '👍',
    title: 'Remy picked you',
    text: 'Nobody can buy or ask for a Chomp Approved sticker. Remy gives them out only when something is truly, officially awesome.',
    color: 'var(--color-chomp-red)',
  },
  {
    emoji: '✅',
    title: 'It’s a yes. Period.',
    text: 'There are no stars, scores, or rankings here. Approval is a simple yes, and you got one.',
    color: 'var(--color-chomp-blue)',
  },
  {
    emoji: '🌟',
    title: 'Show it off',
    text: 'Stick it on your window, door, register, laptop, or lunchbox. It means you made a kid very happy.',
    color: 'var(--color-chomp-green)',
  },
];
---

<Layout
  title="Got a Sticker?"
  description="Got a CHOMP APPROVED! sticker? Congratulations! Here’s what it means and how to find your listing."
>
  <section class="relative overflow-hidden border-b-4 border-ink bg-chomp-orange">
    <div
      class="pointer-events-none absolute inset-0 opacity-25"
      aria-hidden="true"
      style="background: repeating-conic-gradient(from 0deg at 50% 50%, #fff 0deg 9deg, transparent 9deg 18deg);"
    >
    </div>
    <div class="relative mx-auto max-w-4xl px-4 py-10 sm:py-14 text-center">
      <p class="text-5xl sm:text-6xl" aria-hidden="true">🎉🏆🎉</p>
      <h1 class="outline-text mt-3 text-4xl sm:text-6xl">You got a sticker!</h1>
      <Picture
        src={logo}
        alt="The CHOMP APPROVED! sticker"
        widths={[240, 360, 480]}
        sizes="240px"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="eager"
        class="mx-auto mt-6 w-60 h-auto rotate-[-5deg] drop-shadow-[6px_10px_0_rgb(20_20_20/0.25)]"
      />
      <p class="mx-auto mt-6 max-w-xl text-xl sm:text-2xl font-display font-semibold">
        Congratulations! You are officially <span class="whitespace-nowrap">Chomp Approved.</span>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-12" aria-labelledby="meaning-heading">
    <h2 id="meaning-heading" class="mb-6 text-3xl sm:text-4xl">What does it mean?</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {
        points.map((p) => (
          <div class="sticker tilt-hover p-5" style={`--cat:${p.color}`}>
            <p class="grid size-14 place-items-center rounded-full border-[3px] border-ink bg-cat text-3xl" aria-hidden="true">
              {p.emoji}
            </p>
            <h3 class="mt-3 text-2xl">{p.title}</h3>
            <p class="mt-1 text-lg leading-snug">{p.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="find" class="mx-auto max-w-6xl px-4 pt-14 scroll-mt-20" aria-labelledby="find-heading">
    <h2 id="find-heading" class="text-3xl sm:text-4xl">Find your listing <span aria-hidden="true">🔎</span></h2>
    <p class="mt-2 mb-6 text-lg">Type your name, business, or town. Every sticker comes with a spot on this site.</p>
    <SearchableList
      entries={stickered}
      showChips={false}
      placeholder="Your name, business, or town…"
      label="Find your listing"
    >
      <Fragment slot="empty">
        New listings can take a few days to show up after you get your sticker. Check back soon, or
        <a href="/all/" class="underline">browse all approvals</a>.
      </Fragment>
    </SearchableList>
  </section>
</Layout>
